# ============================================================================
# 智多星标书辅助系统 Web 网页版镜像
# ----------------------------------------------------------------------------
# 项目前端有两个包：
#   - packages/app      → Electron 桌面客户端（强依赖 IPC/preload，electron-builder 打包分发，不走 Docker）
#   - packages/desktop  → 网页版（renderer 用 axios 直调 /api/*，可脱离 Electron）
# 本镜像构建 packages/desktop 的 renderer → nginx 托管 + 反代 /api → api 服务。
# ----------------------------------------------------------------------------
# 构建：
#   docker build -f docker/Dockerfile.web -t bidmaster-pro-web:latest .
# ============================================================================

# ─────────────── Stage 1: 构建网页版静态资源 ───────────────
FROM node:20-alpine AS builder

WORKDIR /build

# 先拷贝依赖声明，利用层缓存（package*.json 匹配 package.json，若有 lock 一并拷入）
COPY packages/desktop/package*.json ./
# 如果 lock 不存在，跳过 npm ci 回退到 npm install
ARG NPM_REGISTRY=https://registry.npmmirror.com
# packages/desktop 的 devDependencies 含 electron，其 postinstall 会从 GitHub Releases
# 下载桌面端二进制；而网页镜像只跑 tsc + vite build，用不到这个二进制。
# 国内网络拉它常被中断（npm error ReadError: The server aborted pending request），
# 此前靠构建层缓存侥幸命中，缓存一失效冷构建必挂。故默认跳过下载，
# 并配好国内镜像源与 npm 重试参数兜底。需要产出桌面端时：
#   docker build --build-arg ELECTRON_SKIP_BINARY_DOWNLOAD= ...
ARG ELECTRON_SKIP_BINARY_DOWNLOAD=1
ARG ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/
ENV ELECTRON_SKIP_BINARY_DOWNLOAD=${ELECTRON_SKIP_BINARY_DOWNLOAD} \
    ELECTRON_MIRROR=${ELECTRON_MIRROR}
RUN npm config set registry ${NPM_REGISTRY} \
 && npm config set fetch-retries 5 \
 && npm config set fetch-retry-mintimeout 20000 \
 && npm config set fetch-retry-maxtimeout 120000 \
 && if [ -f package-lock.json ]; then npm ci; else npm install; fi

# 拷贝网页版源码与配置（tsconfig.json / vite.config.ts / renderer / preload / main）
COPY packages/desktop/ ./

# 构建生产静态资源（vite build 输出到 /build/dist）
RUN npm run build


# ─────────────── Stage 2: nginx 托管 ───────────────
FROM nginx:1.27-alpine AS runtime

# 拷贝自定义 nginx 配置（反向代理 /api → api 服务，SSE 流式支持）
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf

# 拷贝构建产物到 nginx 的 /zdx 子路径目录
COPY --from=builder /build/dist /usr/share/nginx/html/zdx

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD wget -q --spider http://127.0.0.1/zdx/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
